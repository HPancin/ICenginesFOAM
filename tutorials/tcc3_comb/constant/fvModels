FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Spark ignition in the sparkPlug cell zone (see constant/zonesGenerator)
// Firing TDC is at 720 CAD (0 CAD), so ignition starts at 700 CAD
ignition
{
    type                constantbXiIgnition;

    cellZone            sparkPlug;

    period              720;

    start               700;
    duration            5;
    strength            2;
}

correction
{
    type            bXiKernelCorr;

    cellZone        all;

    ignition        sparkPlug;

    duration        20;

    kernelShape
    {
        type            spherical;
        thickness       0.01;
        sphereFraction  1;
    }
}

viscousHeating.u
{
    type viscousHeating;
    phase u;
}

viscousHeating.b
{
    type viscousHeating;
    phase b;
}


