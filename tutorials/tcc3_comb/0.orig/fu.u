FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      fu.u;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// Fuel (H2) mass fraction in the unburnt phase
// Stoichiometric H2/air: Y_H2 = 1/(1 + 34.074) = 0.0285
internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    staticWall
    {
        type            zeroGradient;
    }

    movingWall
    {
        $staticWall;
    }

    inlet
    {
        type            inletOutlet;
        phi             alphaPhi.u;
        inletValue      uniform 0.0285;
        value           uniform 0;
    }

    outlet
    {
        type            inletOutlet;
        phi             alphaPhi.u;
        inletValue      uniform 0;
        value           uniform 0;
    }
}


// ************************************************************************* //
