FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      egr.u;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// Diluent (injected water as steam, H2O) mass fraction in the unburnt phase
internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    staticWall
    {
        type            zeroGradient;
    }

    movingWall
    {
        $staticWall;
    }

    inlet
    {
        // Water injection: 20% mass fraction of steam in the intake charge
        type            inletOutlet;
        phi             alphaPhi.u;
        inletValue      uniform 0.20;
        value           uniform 0;
    }

    outlet
    {
        type            inletOutlet;
        phi             alphaPhi.u;
        inletValue      uniform 0;
        value           uniform 0;
    }
}


// ************************************************************************* //
